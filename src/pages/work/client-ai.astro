<!--
  The five process marks come out of Figma as filled shapes carrying a 1px
  inside stroke in the artboard's own background — the trick that thins the
  drawn line without redrawing the path. Keeping that stroke as ink doubled the
  weight instead, so the color is set here rather than baked into the files:
  paper, which follows the palette into dark mode. The per-icon stroke-widths
  stay in the files, since each was drawn at its own scale.

  Not scoped: Astro's scoped styles tag the elements in this template, and these
  paths live inside the imported SVG components.
-->
<style is:global>
  /* The HMW annotations.

     The extent of each fragment is a tinted run rather than a rule under it:
     an underline sits at a fixed distance from the baseline, which put the
     goal's line halfway between two lines of a wrapped sentence and left the
     three marks at three different weights. A tint has no such geometry — it
     wraps with the words, `box-decoration-break: clone` gives every line its
     own rounded ends, and nothing has to be measured.

     The label is a ruby annotation, which is the markup for "this word names
     that run of text". The goal's sits under its clause, as the deck has it:
     the fragment is the tail of the sentence and its own line, so a label
     underneath closes the statement instead of crowding the line above. */
  .hmw {
    line-height: 1.85;
  }

  .hmw ruby {
    background-color: var(--color-off-white);
    border-radius: 0.2em;
    padding: 0.06em 0.22em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hmw rt {
    font-family: var(--font-sans);
    font-size: 0.34em;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-darkin-muted);
    /* Ruby packs the annotation hard onto the base; this is the air that makes
       the label read as a caption of the run rather than as a superscript on
       its first word. */
    padding-bottom: 0.9em;
  }

  /* The goal's label hangs under its clause — but only from desktop up, where
     the break above puts that clause on a line of its own. Narrower than that
     the clause wraps, and an under-label is drawn beneath the FIRST of its
     lines, i.e. straight through the second one. There it stays above with the
     other two. */
  @media (min-width: 1024px) {
    .hmw-goal {
      ruby-position: under;
    }

    .hmw-goal rt {
      padding-top: 0.9em;
      padding-bottom: 0;
    }
  }

  .dt-icon path {
    stroke: var(--color-white);
  }
</style>
