---
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Work", href: "/#work" },
];

// The nav sits on every page, so the current one shouldn't link to itself.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!-- Fixed rather than sticky: sticky is bounded by its containing block, and the
     hero is an overflow-hidden section, so a sticky header would unstick the
     moment the hero scrolled past. Fixed also takes it out of flow, which is why
     the pages below reserve --header-h. -->
<header
  data-header
  class="fixed inset-x-0 top-0 z-50 flex items-start justify-between gap-gutter px-[calc(var(--spacing-gutter)+0.75rem)] pt-gutter pb-5"
>
  <!-- Two lines on mobile, one from tablet up.

       On one line the title and the nav together need more width than a phone
       has, and the loser is the nav: the toggle ends up jammed against the
       right edge. Breaking the title instead costs nothing — the header is out
       of flow and its height is measured at runtime, so the pages below follow
       it — and the break is placed by hand rather than left to the wrap, since
       the ampersand belongs with the word it joins. -->
  <div class="flex flex-col tablet:flex-row tablet:items-baseline tablet:gap-3">
    <a
      href="/"
      data-anim="header-item"
      class="text-body font-semibold tablet:whitespace-nowrap"
      >UX Designer <br class="tablet:hidden" />&amp; Developer</a
    >
  </div>

  <nav class="flex shrink-0 items-baseline gap-5 tablet:gap-8">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          data-anim="header-item"
          aria-current={link.href === path ? "page" : undefined}
          class="text-body font-semibold hover:text-orange aria-[current=page]:text-darkin-muted"
        >
          {link.label}
        </a>
      ))
    }

    <!-- Sits with the nav links rather than apart from them: it is one more way
         to change what you are looking at. No label — the pair of glyphs is the
         whole vocabulary, and a word here would outweigh "About" and "Work".

         Hidden until JS resolves a theme, since without JS there is nothing to
         toggle; `visibility` rather than `display` so the nav never reflows. -->
    <button
      type="button"
      data-theme-toggle
      data-anim="header-item"
      aria-label="Switch theme"
      class="self-center text-darkin transition-colors hover:text-orange"
    >
      <svg class="h-5 w-5" aria-hidden="true" data-theme-icon="sun">
        <use href="#icon-sun" />
      </svg>
      <svg class="h-5 w-5" aria-hidden="true" data-theme-icon="moon">
        <use href="#icon-moon" />
      </svg>
    </button>
  </nav>
</header>
