---
import { Image } from "astro:assets";
import joaco from "../assets/img/joaco.avif";
---

<!-- The header is fixed and lives in the layout now, so its height is reserved
     with padding instead. Because the box is border-box, the section still
     measures exactly one viewport and the band below the header is the same
     size it was when the header sat in flow here. -->
<section
  data-hero
  class="relative flex h-svh min-h-[34rem] flex-col overflow-hidden pt-[var(--header-h)]"
>
  <!-- The portrait is not centred in the leftover band: the name eats a third of
       the viewport on desktop but only a sliver on mobile, so centring alone
       drifts. --hero-img-bias corrects it per layout. Desktop stays at 0 — at
       22vw, Instrument Serif leaves no room to push the portrait down without
       its ascenders colliding with the photo on short viewports. -->
  <div
    class="flex min-h-0 flex-1 items-center justify-center px-gutter [--hero-img-bias:-9vh] tablet:[--hero-img-bias:-2vh] desktop:[--hero-img-bias:-1.5vh]"
  >
    {/* `<Image>` rather than a bare <img>: the source is 3369px wide and the
        portrait never renders above ~411 CSS px, so a plain tag shipped the
        whole thing. 420 and 840 are that size at 1x and 2x. */}
    <Image
      src={joaco}
      widths={[420, 840]}
      sizes="(min-width: 640px) 420px, 56vw"
      format="avif"
      alt="Joaquín Mesa"
      data-portrait
      transition:name="portrait"
      class="aspect-square max-h-full w-[56vw] translate-y-[var(--hero-img-bias)] object-cover tablet:h-[min(25.7rem,40svh)] tablet:w-auto desktop:h-[min(24.5rem,35svh)] desktop:w-auto rounded-full"
    />
  </div>

  <!-- Sized in vw so the name spans the full viewport width at every size.
       --hero-name-w is the tuned coefficient — see global.css. -->
  <h1 data-anim="hero-name" class="hero-name">Joaquín Mesa</h1>
</section>
