---
import { EMAIL, LINKEDIN, RESUME, SOCIALS } from "../data/socials";
---

<footer class="flex h-svh min-h-[34rem] flex-col justify-end px-gutter">
  <!-- The name sits low: it is the last thing on the page, so the empty space
       belongs above it, not split around it. -->
  <h2
    data-anim="lines"
    class="footer-name [--footer-name-w:26.6vw] tablet:[--footer-name-w:27.2vw] desktop:[--footer-name-w:14.8vw]"
  >
    Let&apos;s work together
  </h2>

  <!-- A real element rather than a border, so it can be drawn left to right. -->
  <div data-anim="rule" class="mt-section-sm h-px w-full bg-hairline"></div>

  <!-- Three equal columns rather than justify-between: with space-between the
       middle item only lands centred when the outer two happen to match in
       width, and the left group is far wider than "Resume". Equal columns centre
       the icons on the page regardless of what flanks them. -->
  <div
    data-group
    class="flex flex-col gap-6 py-gutter text-body tablet:grid tablet:grid-cols-3 tablet:items-center tablet:gap-gutter"
  >
    <div
      data-anim="item"
      class="flex flex-col gap-2 tablet:flex-row tablet:items-center tablet:gap-6"
    >
      <a
        href={LINKEDIN}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold transition-colors hover:text-orange"
      >
        LinkedIn
      </a>
      <a href={`mailto:${EMAIL}`} class="font-semibold transition-colors hover:text-orange">
        {EMAIL}
      </a>
    </div>

    <!-- Stacked, the icons read as a footnote to the text links, so they go last;
         in a row they belong between the two text groups. -->
    <nav
      data-anim="item"
      class="order-1 flex items-center gap-6 tablet:order-none tablet:justify-center"
      aria-label="Social media"
    >
      {
        SOCIALS.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-darkin transition-colors hover:text-orange"
            aria-label={s.label}
          >
            <svg class="h-5 w-5" fill="currentColor" aria-hidden="true">
              <use href={`#icon-${s.icon}`} />
            </svg>
          </a>
        ))
      }
    </nav>

    <a
      href={RESUME}
      data-anim="item"
      target="_blank"
      rel="noopener noreferrer"
      class="font-semibold transition-colors hover:text-orange tablet:justify-self-end"
    >
      Resume
    </a>
  </div>
</footer>
