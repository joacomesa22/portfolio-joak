---
import "@fontsource-variable/onest";
import "@fontsource/instrument-serif/400.css";
// The two faces the first screen actually renders in, imported for their URLs
// so they can be preloaded below. See the <link rel="preload"> pair in <head>.
import onestLatin from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";
import serifLatin from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Joaquín Mesa — UX Designer & Developer",
  description = "Portfolio of Joaquín Mesa, UX/UI designer and front-end developer based in Buenos Aires.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Both faces are `font-display: swap`, and without this the browser only
         learns they exist after the stylesheet has parsed — a second round trip
         during which the page is drawn in a fallback. Preloading them alongside
         the stylesheet collapses that window; the metric-matched fallbacks in
         global.css cover whatever is left of it. Latin only: the other subsets
         are not on the first screen and can load normally. -->
    <link rel="preload" as="font" type="font/woff2" href={onestLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={serifLatin} crossorigin />
    <!-- Kept in sync with the active theme by theme.ts; the value here is only
         what the light palette resolves to. -->
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />

    <!-- Resolves the theme before the body paints, so a returning dark-mode
         visitor never gets a white flash. Deliberately not a module and
         deliberately ahead of everything else in <head>: it has to run now,
         synchronously. theme.ts owns every later change; this only sets the
         opening state.

         Light unless dark was explicitly chosen and stored — the OS preference
         is not consulted. The attribute is written either way, since the toggle
         stays hidden until one is present.
         The storage key is shared with theme.ts — change both together. -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {
          /* private mode; the default stands */
        }
        var theme = stored === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        if (theme === "dark") {
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = "#001621";
        }
      })();
    </script>

    <!-- Marks the document as animatable before first paint, so animated
         elements are hidden from the very first frame instead of flashing at
         their final position. Deliberately not a module: it must run now. If JS
         is off or motion is reduced the class never lands and nothing hides. -->
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("anim");

        // Safety net: hiding content up front means a failure to load the
        // animation module would leave the page permanently blank. If nothing
        // has claimed the hook shortly after load, drop it and show everything —
        // an unanimated page beats an invisible one.
        setTimeout(function () {
          if (!document.documentElement.dataset.animReady) {
            document.documentElement.classList.remove("anim");
          }
        }, 3000);
      }
    </script>
  </head>
  <body>
    <IconSprite />
    <Header />
    <slot />

    <!-- Rides alongside the native cursor; see cursor.ts. -->
    <div data-cursor aria-hidden="true">
      <span data-cursor-label>View Work</span>
    </div>

    <script>
      import { initSmoothScroll, destroySmoothScroll } from "../scripts/smooth-scroll";
      import { initAnimations, destroyAnimations } from "../scripts/animations";
      import { initHeader, destroyHeader } from "../scripts/header";
      import { initCursor, destroyCursor } from "../scripts/cursor";
      import { initTheme, destroyTheme } from "../scripts/theme";

      // Duplicates what initTheme does, because after-swap fires ahead of
      // page-load and the new DOM must not paint in the old theme first.
      function restoreTheme() {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {
          /* private mode */
        }
        document.documentElement.dataset.theme =
          stored === "dark" ? "dark" : "light";
      }

      // With the router in play this module runs once, not per page, so the
      // lifecycle events drive it: tear Lenis and the ScrollTriggers down before
      // the swap so they can't fight the transition or leak across pages, then
      // rebuild against the new DOM. astro:page-load also fires on first load.
      document.addEventListener("astro:before-swap", () => {
        destroyAnimations();
        destroySmoothScroll();
        destroyHeader();
        destroyCursor();
        destroyTheme();
      });

      // The swap replaces <html>'s attributes, so the class the inline script
      // added is lost on every navigation and has to be put back. This fires
      // before the new DOM paints, which is what keeps elements hidden until
      // GSAP reveals them. `navigated` rides along so the portrait is never
      // re-hidden — from here on it belongs to the View Transition.
      document.addEventListener("astro:after-swap", () => {
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("anim", "navigated");
        }
        // Same reason as the class above: the swap wipes <html>'s attributes,
        // and data-theme is one of them. Restoring it here rather than in
        // initTheme keeps the theme from flashing during the transition.
        restoreTheme();
      });

      document.addEventListener("astro:page-load", () => {
        // First, so the page it renders into is already the right theme.
        initTheme();
        initSmoothScroll();
        initHeader();
        initCursor();
        void initAnimations();
      });
    </script>
  </body>
</html>
